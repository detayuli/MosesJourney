  dialogueText: {fileID: 6218725023170596816}
  benarList:
  - text: Oke lanjut
    voEventPath: event:/VoiceOver/Gameplay/Benar/Benar
  - text: gitu dong bener
    voEventPath: event:/VoiceOver/Gameplay/Benar/Benar 2
  - text: ayo pasang lagi
    voEventPath: event:/VoiceOver/Gameplay/Benar/Benar 3
  - text: masih banyak yang kosong nih
    voEventPath: event:/VoiceOver/Gameplay/Benar/Benar 4
  - text: Baru satu, ayo terusin
    voEventPath: event:/VoiceOver/Gameplay/Benar/Benar 5
  - text: Bagus, Udah pas
    voEventPath: event:/VoiceOver/Gameplay/Benar/Benar 6
  salahList:
  - text: Bukan disitu woi
    voEventPath: event:/VoiceOver/Gameplay/Salah/Salah
  - text: Salah tempat tuh
    voEventPath: event:/VoiceOver/Gameplay/Salah/Salah 2
  - text: lah kok disitu?
    voEventPath: event:/VoiceOver/Gameplay/Salah/Salah 3
  - text: Jangan asal taruh woi
    voEventPath: event:/VoiceOver/Gameplay/Salah/Salah 4
  - text: buang di tempat sampah
    voEventPath: event:/VoiceOver/Gameplay/Salah/Salah 5
  buangSampahList:
  - text: Gitu dong, buang sampahnya!
    voEventPath: event:/VoiceOver/Gameplay/BuangSampah/BuangSampah
  - text: Hobi banget buang-buang
    voEventPath: event:/VoiceOver/Gameplay/BuangSampah/BuangSampah 2
  - text: Buset, dibuang semua!
    voEventPath: event:/VoiceOver/Gameplay/BuangSampah/BuangSampah 3
  - text: Singkirin yang gk penting
    voEventPath: event:/VoiceOver/Gameplay/BuangSampah/BuangSampah 4
  - text: Buang-buang terus!
    voEventPath: event:/VoiceOver/Gameplay/BuangSampah/BuangSampah 5
